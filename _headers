/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob: https://opengraph.githubassets.com https://avatars.githubusercontent.com; connect-src 'self' https://api.github.com https://github.com; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=300

/api/*
  Cache-Control: no-store
